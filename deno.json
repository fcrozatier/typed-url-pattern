{
  "name": "@fcrozatier/typed-url-pattern",
  "version": "0.4.0",
  "license": "MIT",
  "tasks": {
    "check:all": "deno fmt --check && deno lint && deno check && deno test -A && deno test -A --doc && deno doc --lint src/typedURLPattern.ts",
    "test:coverage": "deno test -A --coverage && open coverage/html/index.html"
  },
  "exports": {
    ".": "./src/typedURLPattern.ts"
  },
  "imports": {
    "@standard-schema/spec": "jsr:@standard-schema/spec@^1.1.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "zod": "npm:zod@^4.4.3"
  },
  "publish": {
    "include": ["src"],
    "exclude": ["**/*.test.ts"]
  }
}
